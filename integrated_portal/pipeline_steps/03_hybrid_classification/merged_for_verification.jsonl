earch.go.jp/entity/place/イギリス", "schema:url": "https://www.dh-jac.net/db1/books/BM-JIB0916./portal/manifest.json", "https://jpsearch.go.jp/term/property#contentId": ["ARC管理No.: BM-JIB0916.", "資料No.: JIB.916"], "rdf:type": "https://jpsearch.go.jp/term/type/アクセス情報", "https://jpsearch.go.jp/term/property#contentRights": "CC BY-NC-SA 4.0", "schema:usageInfo": "https://www.britishmuseum.org/terms-use/copyright-and-permissions"}, "https://jpsearch.go.jp/term/property#temporal": {"@id": "_:vb115498018", "schema:description": ["年月日備考(成立1): 大正十四年七月五日発行", "西暦(成立１): 1917", "和暦(成立１): 大正１４", "内容(成立1): 刊", "月日(成立１): 07・05"], "https://jpsearch.go.jp/term/property#relationType": "https://jpsearch.go.jp/term/role/制作.成立1", "https://jpsearch.go.jp/term/property#value": "https://jpsearch.go.jp/entity/time/1917"}, "rdfs:label": "ジョスランの子守歌", "schema:image": "https://www.arc.ritsumei.ac.jp/archive01/theater/th_image/PB/BM/Books/BM-JIB0916/BM-JIB0916_001.jpg", "schema:name": ["ジョスランの子守歌", "josurannokomoriuta", "じょすらんのこもりうた"], "https://jpsearch.go.jp/term/property#sourceInfo": {"@id": "https://jpsearch.go.jp/data/arc_books-BM_JIB0916_#sourceinfo", "rdf:type": "https://jpsearch.go.jp/term/type/ソース情報", "https://jpsearch.go.jp/term/property#sourceData": "https://jpsearch.go.jp/item/arc_books-BM_JIB0916_.json", "schema:contributor": "https://jpsearch.go.jp/entity/chname/立命館ARC", "schema:url": "https://www.dh-jac.net/db1/books/BM-JIB0916./portal/", "schema:provider": "https://jpsearch.go.jp/entity/chname/ARC古典籍ポータル", "schema:dateModified": "2020-12-25 00:00:00", "schema:relatedLink": "https://jpsearch.go.jp/item/arc_books-BM_JIB0916_"}, "schema:temporal": "https://jpsearch.go.jp/entity/time/1917", "status": "success", "_inferred_metadata": {"is_score": true, "genre": null, "instruments": [], "_evidence": {"score_reason": "メタデータの「分類（ジャンル・内容）」に「楽譜」と明記されており、別称にも「セノオ楽譜」と含まれているため。", "stage": "llm_inferred_web", "retrieved_web_snippets": ["・ジョスランの子守歌 歌詞の意味 - 世界の民謡・童謡\n  オペラ『ジョスラン』が今日上演される機会はほとんどなく、『ジョスランの子守歌』だけが独立した楽曲として単独で演奏されるほか、安眠・リラックス系クラシック音楽CDの一曲としてコンピレーション・アルバムに収録されることがよくあるようだ。\n・ジョスランの子守歌とは？ 意味や使い方 - コトバンク\n  デジタル大辞泉プラス - ジョスランの子守歌の用語解説 - フランスの作曲家バンジャマン・ゴダールの声楽曲。 原題《Berceuse de Jocelyn》。 オペラ『ジョスラン』（1888）の第2幕で歌われる子守唄。\n・ジョスランの子守歌 - 二木紘三のうた物語\n  『ジョスラン』は、1888年2月25日にブリュッセルで初演されましたが、現代ではほとんど上演されず、『ジョスラン子守歌（Berceuse de Jocelyn）』だけが歌われたり、演奏されたりします。 『ジョスラン』の舞台は革命期のフランス。 フランス革命では、アンシャン・レジーム（旧体制）の時代に特権を享受していた聖職者や貴族たちが激しく弾圧されました。 さらに、啓蒙主義の「理性による思考」が過剰に重視され、それに反すると目された文物は排斥されました。 カトリックの典礼やしきたりは非理性的な習俗とされ、フランス全土でミサは禁止、教会や僧院は閉鎖、略奪、破壊の憂き目に遭いました。 多くの聖職者が殺され、あるいは追放されました。"]}}}
